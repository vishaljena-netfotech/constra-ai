# Copy to .env.production on the NeevCloud host and fill in real values.
# NEVER commit the filled-in .env.production file to git or bake it into the Docker image.

# --- Database (MySQL/TiDB-compatible) ---
DATABASE_URL=

# --- Session / auth ---
JWT_SECRET=

# --- Manus OAuth (required for login to keep working) ---
OAUTH_SERVER_URL=
VITE_OAUTH_PORTAL_URL=
VITE_APP_ID=

# --- Manus Forge API (AI plan analysis, storage, notifications) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
VITE_FRONTEND_FORGE_API_URL=
VITE_FRONTEND_FORGE_API_KEY=

# --- Owner-facing operational alerts ---
OWNER_OPEN_ID=
OWNER_NAME=

# --- Runtime ---
PORT=3000
